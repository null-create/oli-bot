# Backend selection: "ollama", "openai", or "huggingface"
OLI_BACKEND=ollama

# Ollama configuration
OLI_OLLAMA_BASE_URL="http://localhost:11434"
OLI_OLLAMA_MODEL=""
OLI_OLLAMA_SMALL_MODEL=""

# OpenAI configuration
OLI_OPENAI_BASE_URL="https://api.openai.com/v1"
OLI_OPENAI_API_KEY=""
OLI_OPENAI_MODEL=""
OLI_OPENAI_SMALL_MODEL=""
# Vision serialization: "openai" (default) or "bedrock" (for Kong/LiteLLM proxies fronting Bedrock)
OLI_OPENAI_VISION_STYLE="openai"

# HuggingFace configuration
OLI_HUGGINGFACE_BASE_URL="https://api-inference.huggingface.co"
OLI_HUGGINGFACE_API_KEY=""
OLI_HUGGINGFACE_MODEL=""
OLI_HUGGINGFACE_SMALL_MODEL=""
# true: HuggingFace Inference API (needs api_key); false: local TGI/vLLM at base_url
OLI_HUGGINGFACE_REMOTE=false

# Transformers configurations
OLI_TRANSFORMERS_MODEL=""
OLI_TRANSFORMERS_SMALL_MODEL=""
OLI_TRANSFORMERS_DEVICE="auto"
OLI_TRANSFORMERS_DTYPE="auto"
OLI_TRANSFORMERS_IS_MULTI_MODEL=false

# General Agent configs
OLI_USE_AGENT_POOL=false
OLI_AGENT_POOL_SIZE=5
OLI_MAX_TOKENS=8192
OLI_TEMPERATURE=0.7
OLI_MAX_RETRIES=3
OLI_RETRY_DELAY=1.0
OLI_REQUEST_TIMEOUT=30.0
OLI_MAX_MESSAGES=100
OLI_MAX_TOOL_ITERATIONS=25
OLI_STREAM_TIMEOUT=240.0
OLI_MODEL_FILTERS=""
OLI_PROFILES_DIR=""
OLI_LOGS_DIR=""

# Tool result truncation (per model tier)
OLI_TRUNCATION_SMALL=4000
OLI_TRUNCATION_LARGE=100000

# Dry-run: preview destructive actions without executing
OLI_DRY_RUN=false

# Offline mode: block network access for web tools and MCP servers
OLI_OFFLINE_MODE=true

# Logging
OLI_LOG_LEVEL=INFO
OLI_LOG_FILE="logs/backend.ndjson"

# API server (api_server.py — OpenAI-compatible REST interface)
OLI_API_HOST="0.0.0.0"
OLI_API_PORT=8000
OLI_API_PROFILE="default"
OLI_API_MODE="agent"
