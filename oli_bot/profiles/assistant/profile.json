{
  "schema_version": 1,
  "name": "assistant",
  "version": "1.0.0",
  "description": "General-purpose assistant that inherits default and actively persists knowledge to the long-term-memory MCP server",
  "default_model_tier": "large",
  "base": "default",
  "required_tools": [
    "long-term-memory__memory_store",
    "long-term-memory__memory_recall",
    "long-term-memory__knowledge_check"
  ],
  "permissions": {
    "allow_tools": ["builtin__*", "long-term-memory__*"],
    "deny_tools": []
  }
}
