{
  "schema_version": 1,
  "name": "search-agent",
  "version": "1.0.0",
  "description": "Specialist web-research agent — high recall and high precision for structured research tasks",
  "default_model_tier": "small",
  "required_tools": [
    "builtin__websearch",
    "builtin__fetch",
    "builtin__search_wikipedia",
    "builtin__search_github",
    "builtin__search_arxiv",
    "builtin__search_google",
    "builtin__search_stackoverflow",
    "builtin__search_bing",
    "builtin__search_open_library",
    "builtin__search_hacker_news",
    "builtin__search_gnews",
    "builtin__extract_article",
    "builtin__think",
    "builtin__todowrite",
    "builtin__notebook",
    "builtin__read_file",
    "builtin__glob",
    "builtin__grep",
    "builtin__compare"
  ],
  "base": null,
  "permissions": {
    "allow_tools": [
      "builtin__websearch",
      "builtin__fetch",
      "builtin__search_wikipedia",
      "builtin__search_github",
      "builtin__search_arxiv",
      "builtin__search_google",
      "builtin__search_stackoverflow",
      "builtin__search_bing",
      "builtin__search_open_library",
      "builtin__search_hacker_news",
      "builtin__search_gnews",
      "builtin__extract_article",
      "builtin__think",
      "builtin__todowrite",
      "builtin__notebook",
      "builtin__read_file",
      "builtin__glob",
      "builtin__grep",
      "builtin__compare",
      "builtin__list_directory",
      "builtin__tree"
    ],
    "deny_tools": [
      "builtin__write_file",
      "builtin__edit_file",
      "builtin__download_file",
      "builtin__upload_file",
      "builtin__run_command"
    ]
  }
}